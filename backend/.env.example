APP_ENV=development
APP_NAME=Sistema de Orquestacion Bancaria
BANK_NAME=Banco Mercantil Santa Cruz
BRANCH_NAME=Sucursal Centro
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://orquestacion:orquestacion@localhost:5432/orquestacion
DATABASE_MIGRATION_URL=postgresql+psycopg://orquestacion:orquestacion@localhost:5432/orquestacion
REDIS_URL=redis://localhost:6379/0
TRUSTED_PROXY_CIDRS=127.0.0.1/32
METRICS_TOKEN=replace-with-a-random-observability-token
SUPABASE_URL=
OPENAI_API_KEY=
VOICE_MODEL=gpt-realtime-2.1-mini
TRANSCRIPTION_MODEL=gpt-realtime-whisper
ORCHESTRATION_MODEL=gpt-5.4-mini
# none|low|medium|high|xhigh. Both calls block a waiting customer; see core/config.py.
CLASSIFICATION_REASONING_EFFORT=low
GROUNDING_REASONING_EFFORT=low
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
REALTIME_VOICE=marin
RAG_TOP_K=5
RAG_MIN_SCORE=0.45
RAG_MAX_CONTEXT_TOKENS=3000
RAG_CHUNK_TOKENS=600
RAG_CHUNK_OVERLAP=100
RAG_CORPUS_DIR=../doc/rag
KNOWLEDGE_STORAGE_DIR=../data/knowledge
KNOWLEDGE_MAX_UPLOAD_MB=20
KNOWLEDGE_MAX_PAGES=300
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
JWT_SECRET=replace-with-at-least-32-random-characters
IDENTIFIER_PEPPER=replace-with-another-random-secret
IDENTIFIER_ENCRYPTION_KEYS={"v1":"replace-with-base64-encoded-32-byte-key"}
IDENTIFIER_ACTIVE_KEY_ID=v1
CONVERSATION_RETENTION_DAYS=90
CONVERSATION_CLEANUP_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_HOURS=8
KIOSK_SESSION_MINUTES=30
SEED_EXECUTIVE_PASSWORD=replace-with-executive-password
SEED_MANAGER_PASSWORD=replace-with-manager-password
SEED_DATA_PATH=seed/operational_seed.json
DASHBOARD_REFRESH_MS=10000
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.68
MAX_CLARIFICATIONS=2
OPENAI_TIMEOUT_SECONDS=20
ESTIMATED_SERVICE_MINUTES=8
SUPPORT_TRACKING_INFORMATION=Para seguimiento o reclamos, utiliza los canales oficiales de atención de la entidad.
