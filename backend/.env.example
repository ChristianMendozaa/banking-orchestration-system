APP_ENV=development
APP_NAME=Sistema de Orquestacion Bancaria
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://orquestacion:orquestacion@localhost:5432/orquestacion
DATABASE_MIGRATION_URL=postgresql+psycopg://orquestacion:orquestacion@localhost:5432/orquestacion
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
VOICE_MODEL=gpt-realtime-2.1-mini
ORCHESTRATION_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
REALTIME_VOICE=marin
RAG_TOP_K=5
RAG_MIN_SCORE=0.45
RAG_MAX_CONTEXT_TOKENS=3000
RAG_CHUNK_TOKENS=600
RAG_CHUNK_OVERLAP=100
RAG_CORPUS_DIR=../doc/rag
JWT_SECRET=replace-with-at-least-32-random-characters
IDENTIFIER_PEPPER=replace-with-another-random-secret
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_HOURS=8
SEED_EXECUTIVE_PASSWORD=ChangeMe-Executive-2026
SEED_MANAGER_PASSWORD=ChangeMe-Manager-2026
