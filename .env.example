# =============================================================================
# Sistema de Orquestacion Bancaria -- the one configuration file
# =============================================================================
# A single .env at the repository root serves every process:
#   - the backend, Alembic and the scripts (backend/app/core/config.py locates it),
#   - Docker Compose (${...} interpolation, and env_file for the backend containers),
#   - the frontend dev server (frontend/next.config.ts loads it).
#
#   cp .env.example .env    # then replace every placeholder; never commit .env
#
# Values under "Backend on the host" describe a backend running directly on this
# machine. Under Compose the backend containers override them with in-network values
# (x-backend-environment in docker-compose.yml), so one file serves both.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Sistema de Orquestacion Bancaria
BANK_NAME=Banco Mercantil Santa Cruz
BRANCH_NAME=Sucursal Centro
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# AI models: Anthropic -- classification, confirmation reading, grounded answers
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ORCHESTRATION_MODEL=claude-haiku-5-5
# low|medium|high|xhigh|max. Both calls block a waiting customer; see core/config.py.
CLASSIFICATION_REASONING_EFFORT=low
GROUNDING_REASONING_EFFORT=low
ANTHROPIC_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# AI models: OpenAI -- realtime voice and embeddings
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
VOICE_MODEL=gpt-realtime-2.1-mini
TRANSCRIPTION_MODEL=gpt-realtime-whisper
REALTIME_VOICE=marin
# The pgvector schema is fixed at 1536 dimensions.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# Docker Compose: database, published ports, browser origins
# -----------------------------------------------------------------------------
POSTGRES_DB=orquestacion
POSTGRES_USER=orquestacion
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_PORT=5432
REDIS_PORT=6379
# Also the port a backend running on the host connects to.
CLAMAV_PORT=3310
BACKEND_PORT=8000
KIOSK_FRONTEND_PORT=3000
STAFF_FRONTEND_PORT=3001
# Must match the browser-visible origins, including behind a reverse proxy.
KIOSK_FRONTEND_ORIGIN=http://localhost:3000
STAFF_FRONTEND_ORIGIN=http://localhost:3001
# Proxies the backend containers trust: the Compose network.
DOCKER_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# -----------------------------------------------------------------------------
# Backend on the host (ignored by the Compose containers)
# -----------------------------------------------------------------------------
# Must agree with POSTGRES_* and POSTGRES_PORT above.
DATABASE_URL=postgresql+psycopg://orquestacion:replace-with-local-database-password@localhost:5432/orquestacion
DATABASE_MIGRATION_URL=postgresql+psycopg://orquestacion:replace-with-local-database-password@localhost:5432/orquestacion
# Must agree with REDIS_PORT above.
REDIS_URL=redis://localhost:6379/0
CLAMAV_HOST=localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Proxies a host-run backend trusts: the Next.js proxy on this machine.
TRUSTED_PROXY_CIDRS=127.0.0.1/32
SUPABASE_URL=

# -----------------------------------------------------------------------------
# Secrets and access
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-at-least-32-random-characters
IDENTIFIER_PEPPER=replace-with-another-random-secret
IDENTIFIER_ENCRYPTION_KEYS={"v1":"replace-with-base64-encoded-32-byte-key"}
IDENTIFIER_ACTIVE_KEY_ID=v1
SEED_EXECUTIVE_PASSWORD=replace-with-executive-password
SEED_MANAGER_PASSWORD=replace-with-manager-password
METRICS_TOKEN=replace-with-a-random-observability-token
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_HOURS=8

# -----------------------------------------------------------------------------
# Knowledge and RAG (relative paths resolve from backend/, where the process runs)
# -----------------------------------------------------------------------------
RAG_CORPUS_DIR=../doc/rag
KNOWLEDGE_STORAGE_DIR=../data/knowledge
SEED_DATA_PATH=seed/operational_seed.json
RAG_TOP_K=5
RAG_MIN_SCORE=0.45
RAG_MAX_CONTEXT_TOKENS=3000
RAG_CHUNK_TOKENS=600
RAG_CHUNK_OVERLAP=100
KNOWLEDGE_MAX_UPLOAD_MB=20
KNOWLEDGE_MAX_PAGES=300
CLAMAV_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Kiosk and orchestration policy
# -----------------------------------------------------------------------------
KIOSK_SESSION_MINUTES=30
KIOSK_MAX_TURNS=8
KIOSK_FOLLOW_UP_INACTIVITY_SECONDS=20
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.68
MAX_CLARIFICATIONS=2
MAX_CORRECTIONS=2
KIOSK_MAX_CONSECUTIVE_DECLINES=2
ESTIMATED_SERVICE_MINUTES=8
SUPPORT_TRACKING_INFORMATION=Para seguimiento o reclamos, utiliza los canales oficiales de atención de la entidad.
CONVERSATION_RETENTION_DAYS=90
CONVERSATION_CLEANUP_HOURS=24
DASHBOARD_REFRESH_MS=10000

# -----------------------------------------------------------------------------
# Frontend dev server (Compose sets its own values)
# -----------------------------------------------------------------------------
BACKEND_INTERNAL_URL=http://localhost:8000
# APP_SURFACE is per process -- each surface is its own server:
#   APP_SURFACE=kiosk pnpm dev
#   PORT=3001 APP_SURFACE=staff pnpm dev
