BACKEND_INTERNAL_URL=http://localhost:8000
APP_SURFACE=staff
# Reached directly by the browser for the kiosk voice socket; every other backend call
# goes through the Next route-handler proxy instead. Read at request time, so changing it
# needs a restart, not a rebuild. Leave empty when the backend answers on the page's own
# origin.
BACKEND_PUBLIC_URL=http://localhost:8000
